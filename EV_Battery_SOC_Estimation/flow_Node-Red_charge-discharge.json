    {
        "id": "24293734ed26ce27",
        "type": "function",
        "z": "e280aa9ac207a295",
        "name": "SOC daily usage",
        "func": "// 1. Get Inputs\nvar ActualSOC = parseFloat(msg.soc);\nvar DailyUsePercent = parseFloat(msg.daily_use);\n\n// 2. Get the \"Countdown\" from memory (how much is left to drain today)\n// If it doesn't exist yet, we start it at 0.\nvar SOCDailyCount = flow.get(\"var_car_soc_spent\") || 0;\n\n// 3. Calculate the 10-minute slice (e.g., 15% / 32 steps = ~0.31%)\nvar DailyUseStep = DailyUsePercent / 32;\n\n// 4. Initialize the Countdown if it's empty or finished\n// This replaces your \"On Start\" code safely inside the loop\nif (SOCDailyCount <= 0) {\n    SOCDailyCount = DailyUsePercent;\n}\n\n// 5. Calculate the new Countdown for the next run\nvar SOCDailyCountOut = SOCDailyCount - DailyUseStep;\n\n// 6. Calculate the New SOC for the car\n// We ONLY subtract the tiny 10-minute slice (DailyUseStep), NOT the whole budget!\nvar NewEstimSOC = ActualSOC - DailyUseStep;\n\n// Safety: Don't let numbers go below zero\nif (SOCDailyCountOut < 0) { SOCDailyCountOut = 0; }\nif (NewEstimSOC < 0) { NewEstimSOC = 0; }\n\n// 7. Save the new Countdown back to memory\nflow.set(\"var_car_soc_spent\", SOCDailyCountOut);\n\n// Prepare Outputs\nvar Out1 = { NewSOC: NewEstimSOC };\n\n// Output 2 for your visual flow (if you want to see the countdown)\nvar Out2 = { payload: SOCDailyCountOut, topic: \"Remaining_Budget\" };\n\n// Output 3 for Debugging\nvar Out3 = {\n    StepUsed: DailyUseStep,\n    RemainingToday: SOCDailyCountOut,\n    OldSOC: ActualSOC,\n    NewSOC: NewEstimSOC\n};\n\nreturn [Out1, Out2, Out3];",
