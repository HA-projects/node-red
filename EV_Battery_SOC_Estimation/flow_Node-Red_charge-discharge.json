    {
        "id": "56e1c95702d095a1",
        "type": "function",
        "z": "e280aa9ac207a295",
        "name": "charged Energy",
        "func": "// Inputs: \n// msg.soc = Current Estimated SOC (not actually used if we use StartSOC)\n// msg.charged = Energy delivered by EVCC in kWh\n// msg.capacity = Battery Capacity in kWh\n\nvar ActualkWh = parseFloat(msg.charged);\nvar CapacitykWh = parseFloat(msg.capacity);\nvar StartSOC = flow.get(\"var_ev_start_soc\") || 0;\n\n// 1. Calculate percentage gained (Energy / Capacity * 100)\nvar ChargedNowSoc = (ActualkWh / CapacitykWh) * 100;\n\n// 2. Add charging losses (Optional but recommended)\n// AC charging is usually ~85-90% efficient. \n// If we ignore this, your virtual SOC will climb faster than the real one.\nvar EfficiencyFactor = 0.90;\nvar RealGainedSoc = ChargedNowSoc * EfficiencyFactor;\n\nvar NewSOC = StartSOC + RealGainedSoc;\n\n// 3. Prevent SOC from exceeding 100%\nif (NewSOC > 100) { NewSOC = 100; }\n\n\n// Prepare outputs for your debug/write nodes\nvar Out1 = { NewSOC: NewSOC }\nvar Out2 = {\n    ActualkWh: ActualkWh,\n    StartSOC: StartSOC,\n    Gained: RealGainedSoc\n};\n\nreturn [Out1, Out2];",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 990,
        "y": 740,
        "wires": [
            [
                "d38beb478fdbf804",
                "b94f77f22bac6a98"
            ],
            [
                "2dc607739da922c4"
            ]
        ]
    },
